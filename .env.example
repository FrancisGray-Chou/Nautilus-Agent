# 从 https://platform.deepseek.com/ 获取 API 密钥
DEEPSEEK_API_KEY=
# 可改为 DeepSeek 支持的其他模型，例如 deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-flash

# OpenAI：https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Gemini：https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 下列两项供库接口 with_provider(Gemini) 使用；终端二级菜单会覆盖模型与搜索设置
GEMINI_MODEL=gemini-3.8-flash
# 开启 Google Search 工具，由模型按需调用；设为 false 使用纯对话
GEMINI_WEB_SEARCH=true

# Claude / Anthropic：https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# CLI / 库默认使用 Opus；桌面端与 Mixture 使用明确选择的预设
# 可选 claude-opus-5-5 / claude-fable-5-1 / claude-sonnet-5-5 / claude-haiku-5-5
CLAUDE_MODEL=claude-opus-5-5

# Mixture 测试版不启用预算限制，不需要任何 MIXTURE_* 价格配置。
# 动态预算算法保留在 src/budget.rs，后续预算版本再开放配置。
